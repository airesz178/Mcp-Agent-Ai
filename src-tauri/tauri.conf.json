{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mcp Agent Ai",
  "version": "0.2.2",
  "identifier": "ai.mcpagent.app",
  "build": {
    "beforeDevCommand": "npm run build:ui",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mcp Agent Ai"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "android": {
      "minSdkVersion": 26
    }
  }
}
